# virtual environment
venv/
.venv/

# python bytecode
__pycache__/
*.py[cod]

# model / dataset caches, if HF_HOME is ever pointed inside the repo
.cache/
models/

# saved embeddings — regenerable, and large
*.npy
*.npz
# the sidecar that records WHAT each .npy holds, so a stale cache is caught
# rather than silently served. Regenerable with the .npy it describes.
data/*_vectors.meta.json

# editor / OS noise
.vscode/
.idea/
.DS_Store

# machine-local Claude Code settings (CLAUDE.md itself IS tracked)
.claude/settings.local.json
.claude/*.tmp.*

# git worktrees live here — they are checkouts of this same repo, plus
# node_modules. Never commit them into the repo they came from.
.claude/worktrees/

# secrets (LLM API keys, Phase 7)
.env
.env.local

# --- web app (Phase 8) ---
node_modules/
.next/
out/
next-env.d.ts
*.tsbuildinfo
.vercel

# logs — real questions from real people, and machine-local runtime noise
logs/

# the HyDE rewrite cache. Every question that reaches the rewriter is written
# here, so once anyone but me uses this app the file fills with other people's
# questions. Same reason logs/ is ignored: what a person asks a Thirukkural app
# is private. Machine-local, rebuilt on demand, costs a few paise to refill.
data/rewrite_cache.jsonl

# generated: rebuild with `zip -r colab_bakeoff.zip colab_bakeoff`
colab_bakeoff.zip
# generated by export_bakeoff_package.py from the corpus + saved results
colab_bakeoff/data/
